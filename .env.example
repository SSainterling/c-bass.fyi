# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Content Layer (if used)
# CONTENT_LAYER_SOURCE=./content

# Analytics (if used)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_POSTHOG_KEY=phk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Keys
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# Feature Flags
# NEXT_PUBLIC_ENABLE_FEATURE_X=true
# NEXT_PUBLIC_ENABLE_FEATURE_Y=false
